{
  "installCommand": "cd Website/frontend && npm install --legacy-peer-deps",
  "buildCommand": "cd Website/frontend && npm run build",
  "outputDirectory": "Website/frontend/build",
  "env": {
    "CI": "false"
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
